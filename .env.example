PORT=3000
# Server: origins allowed to open WebSockets (comma separated). Empty = allow any origin.
# For split deployment, set this on the server to https://your-game.vercel.app.
ALLOWED_ORIGINS=
# Vercel: required at build time, e.g. wss://arena-server.onrender.com.
# Local server: optional; empty = same origin as the page.
PUBLIC_WS_URL=
